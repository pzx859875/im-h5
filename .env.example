# APP environment; dev server defaults to production endpoints too.
VITE_APP_ENV=production
# Optional overrides, matching APP saved server configuration:
# VITE_COMMUNITY_URL=https://chat.yunxi.group/chatRoomApi
# VITE_IM_API_URL=https://chat.yunxi.group
# VITE_IM_WS_URL=wss://chat.yunxi.group/msg_gateway
VITE_IM_ADMIN_ID=imAdmin
VITE_IM_EVENTS=true
# Proposed endpoint is absent in current room-go. Off by default.
VITE_SELF_SNAPSHOT=false
